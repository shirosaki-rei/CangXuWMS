# ---- 应用 ----
APP_NAME=WMS
ENV=dev
API_PREFIX=/api/v1
# 逗号分隔；生产改成实际域名
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 数据库 ----
DB_URL=mysql+pymysql://wms:wms123456@127.0.0.1:3306/wms?charset=utf8mb4
# AI 只读账号（架构 8.1 三道锁之一）；留空则退回 DB_URL，仅限本地开发
DB_READONLY_URL=mysql+pymysql://wms_ai_ro:ro123456@127.0.0.1:3306/wms?charset=utf8mb4

# ---- Redis ----
REDIS_URL=redis://127.0.0.1:6379/0

# ---- JWT ----
JWT_SECRET=please-change-me-to-at-least-32-characters-long-secret
JWT_ALG=HS256
ACCESS_TTL=7200
REFRESH_TTL=604800
IDLE_TTL=28800

# ---- 认证策略 ----
CAPTCHA_TTL=300
LOGIN_FAIL_MAX=5
LOGIN_LOCK_MINUTES=10
IDEMPOTENCY_TTL=86400

# ---- LLM（T-04-5）----
# 留空 = 不接 LLM：库位推荐/路径/校验全走本地规则，问数返回降级。
# 接了就填 OpenAI 兼容的 base_url（含 /v1）。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---- 初始化管理员（seed 用）----
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
